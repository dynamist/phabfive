PHORGE_URL=http://phorge.localhost
# Also answered to, so a client inside the cluster can use the Service name
PHORGE_ALLOWED_URIS=http://phorge.phorge.svc.cluster.local
PHORGE_CDN_URL=http://cdn.localhost
PHORGE_TITLE=RMI
PHORGE_ADMIN_USER=admin
PHORGE_ADMIN_EMAIL=admin@domain.tld
PHORGE_ADMIN_NAME=Administrator
# git over SSH: the user sshd lets in, and the address Phorge advertises in its
# clone URIs, which is where `make ssh-forward` listens. Empty PHORGE_SSH_USER
# turns SSH off.
PHORGE_SSH_USER=git
PHORGE_SSH_HOST=phorge.localhost
PHORGE_SSH_PORT=2222
# Seed modules to run, or "all"
PHORGE_SEED=all
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_USER=root
